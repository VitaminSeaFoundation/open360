--[[
  open360 Reframe for DaVinci Resolve (Fusion Fuse) - stitch + reframe Insta360 .insv 360 video

  Stitches the two fisheye lenses of an Insta360 .insv clip on the GPU and reframes the
  360 sphere to a flat (perspective / tiny planet) view or to a full equirectangular frame,
  in a single resampling pass at the native lens resolution. No transcoding is involved:
  both inputs come straight from the camera-original .insv (symlink + APFS clone).

  Inputs
    Lens0  : MediaIn of "<clip>.mp4" (symlink to the .insv: front lens + audio)
    Lens1  : MediaIn of "<clip>_lens1.mp4" (APFS clone exposing the rear-lens track),
             frame-locked to Lens0 by expressions
             (leave unconnected to reframe an already stitched equirectangular clip)
  Sidecar  : "<clip>.open360.lua" written by open360-stitch --analyze (calibration, gyro)

  All camera controls (Pan / Tilt / Roll / FOV / Lens Curve) are animatable.
]]

FuRegisterClass("Open360Reframe", CT_Tool, {
    REGS_Category = "open360",
    REGS_OpIconString = "i360",
    REGS_OpDescription = "360° stitch + reframe for Insta360 .insv",
    REGS_Company = "open360",
    REGS_HelpTopic = "open360 Reframe",
    REG_NoMotionBlurCtrls = true,
    REG_NoBlendCtrls = false,
    REG_OpNoMask = true,
    REG_SupportsDoD = false,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
    REG_Version = 100,
})

ReframeParams = [[
    float lens0[34];
    float lens1[34];
    float acc[11];
    float stab[9];
    float cam[9];
    int   dstsize[2];
    int   projection;
    int   equirectIn;
    int   showSeam;
    float tanHalf;
    float curve;
    float aspect;
    float feather;
    float invDist;
    float gain1;
]]

-- lens block layout (32 floats), image quantities normalized to the lens image (v from top):
--  0 xi  1 fx  2 fy  3 cx  4 cy   5..8 k1..k4   9..10 p1 p2 (tangential)   11..14 s1..s4 (prism)
--  15..17 translation  18 circle radius  19 u offset  20 u scale
--  21..23 radial profile r0 a1 a2: scale = r0 (1 + a1 u^2 + a2 u^4), u = theta / 90deg
--  24..32 lens rotation matrix (row major)
-- acc block (11 floats): 0..4 bare-lens h(theta) polynomial, 5..9 accessory polynomial, 10 enabled

ReframeKernel = [[
__DEVICE__ float3 mat3mul(__CONSTANTREF__ float* m, float3 v) {
    return to_float3(m[0]*v.x + m[1]*v.y + m[2]*v.z,
                       m[3]*v.x + m[4]*v.y + m[5]*v.z,
                       m[6]*v.x + m[7]*v.y + m[8]*v.z);
}

__DEVICE__ float3 nrm3(float3 v) {
    float l = _sqrtf(v.x*v.x + v.y*v.y + v.z*v.z);
    return to_float3(v.x / l, v.y / l, v.z / l);
}

__DEVICE__ float poly5(__CONSTANTREF__ float* c, float t) {
    return c[0] + t*(c[1] + t*(c[2] + t*(c[3] + t*c[4])));
}

// Extended MEI projection (radial k1..k4, tangential p1 p2, thin prism s1..s4) with an
// optional lens-accessory radius profile. Returns texture coords in .x/.y, validity in .z
__DEVICE__ float3 projectLens(__CONSTANTREF__ float* L, float3 cam, float invDist, __CONSTANTREF__ float* A) {
    float3 c = to_float3(L[24]*cam.x + L[25]*cam.y + L[26]*cam.z,
                         L[27]*cam.x + L[28]*cam.y + L[29]*cam.z,
                         L[30]*cam.x + L[31]*cam.y + L[32]*cam.z);
    c = nrm3(to_float3(c.x - L[15]*invDist, c.y - L[16]*invDist, c.z - L[17]*invDist));
    float den = c.z + L[0];
    if (den <= 0.0001f) return to_float3(0.0f, 0.0f, 0.0f);
    float x = c.x / den, y = c.y / den;
    float q = x*x + y*y;
    float rad = 1.0f + q*(L[5] + q*(L[6] + q*(L[7] + q*L[8])));
    float xd = x*rad + 2.0f*L[9]*x*y + L[10]*(q + 2.0f*x*x) + L[11]*q + L[12]*q*q;
    float yd = y*rad + L[9]*(q + 2.0f*y*y) + 2.0f*L[10]*x*y + L[13]*q + L[14]*q*q;
    float th = _fmaxf(1.0f, _acosf(_fmaxf(-1.0f, _fminf(1.0f, c.z))) * 57.2957795f);
    float uu = (th / 90.0f) * (th / 90.0f);
    float sc = L[21] * (1.0f + uu * (L[22] + uu * L[23]));
    if (A[10] > 0.5f) sc = sc * poly5(A + 5, th) / poly5(A, th);
    float u = L[1]*xd*sc + L[3];
    float v = L[2]*yd*sc + L[4];
    float du = u - L[3], dv = v - L[4];
    float ok = (du*du + dv*dv < L[18]*L[18] && u > 0.0f && u < 1.0f && v > 0.0f && v < 1.0f) ? 1.0f : 0.0f;
    // Fusion images are bottom-up
    return to_float3(L[19] + u*L[20], 1.0f - v, ok);
}

__KERNEL__ void ReframeKernel(__CONSTANTREF__ ReframeParams *params,
                              __TEXTURE2D__ src0, __TEXTURE2D__ src1,
                              __TEXTURE2D_WRITE__ dst)
{
    DEFINE_KERNEL_ITERATORS_XY(x, y)
    if (x >= params->dstsize[0] || y >= params->dstsize[1]) return;
    const float PI = 3.14159265358979f;
    float W = (float)params->dstsize[0], H = (float)params->dstsize[1];
    float px = ((float)x + 0.5f) / W;           // 0..1 left->right
    float py = ((float)y + 0.5f) / H;           // 0..1 bottom->top
    float3 ray;
    if (params->projection == 1) {
        // equirectangular 360 output
        float lon = (px * 2.0f - 1.0f) * PI;
        float lat = (py - 0.5f) * PI;
        ray = to_float3(_cosf(lat) * _sinf(lon), _sinf(lat), _cosf(lat) * _cosf(lon));
    } else {
        // general perspective: eye at (0,0,-d) behind the unit sphere centre.
        // d = 0 rectilinear, d = 1 stereographic (tiny planet), in between = "lens curve".
        float d = params->curve;
        float sx = (px * 2.0f - 1.0f) * params->tanHalf;
        float sy = (py * 2.0f - 1.0f) * params->tanHalf / params->aspect;
        float3 D = nrm3(to_float3(sx, sy, 1.0f + d));
        float ed = -d * D.z;                     // E . D with E = (0,0,-d)
        float t = -ed + _sqrtf(ed*ed - d*d + 1.0f);
        ray = nrm3(to_float3(t*D.x, t*D.y, -d + t*D.z));
    }
    float3 w = mat3mul(params->cam, ray);        // view camera -> world
    float3 b = mat3mul(params->stab, w);         // world -> camera body (stabilization)

    float4 col;
    if (params->equirectIn == 1) {
        float lon = _atan2f(b.x, b.z);
        float lat = _asinf(_fmaxf(-1.0f, _fminf(1.0f, b.y)));
        col = _tex2DVecN(src0, lon / (2.0f * PI) + 0.5f, lat / PI + 0.5f, 15);
    } else {
        // parallax (stitch distance) correction only near the seam: fade out over 20 deg
        float el0 = _asinf(_fmaxf(-1.0f, _fminf(1.0f, b.z)));
        float invD = params->invDist * _fmaxf(0.0f, 1.0f - _fabs(el0) / 0.349f);
        float3 a0 = projectLens(params->lens0, to_float3(b.x, -b.y, b.z), invD, params->acc);
        float3 a1 = projectLens(params->lens1, to_float3(-b.x, -b.y, -b.z), invD, params->acc);
        float4 c0 = _tex2DVecN(src0, a0.x, a0.y, 15);
        float4 c1 = _tex2DVecN(src1, a1.x, a1.y, 15);
        c1 = to_float4(c1.x * params->gain1, c1.y * params->gain1, c1.z * params->gain1, c1.w);
        float elev = _asinf(_fmaxf(-1.0f, _fminf(1.0f, b.z)));
        float k = _fmaxf(0.0f, _fminf(1.0f, elev / params->feather * 0.5f + 0.5f));
        k = k * k * (3.0f - 2.0f * k);
        if (a0.z < 0.5f) k = 0.0f;
        if (a1.z < 0.5f && a0.z > 0.5f) k = 1.0f;
        col = to_float4(c1.x + (c0.x - c1.x) * k, c1.y + (c0.y - c1.y) * k,
                          c1.z + (c0.z - c1.z) * k, 1.0f);
        if (params->showSeam == 1 && k > 0.02f && k < 0.98f) {
            col = to_float4(col.x * 0.5f + 0.5f, col.y * 0.5f, col.z * 0.5f, 1.0f);
        }
    }
    col.w = 1.0f;
    _tex2DVec4Write(dst, x, y, col);
}
]]

------------------------------------------------------------------------------
-- sidecar loading (cached per path + modification)

local sidecarCache = {}

-- errors are written to ~/Library/Logs/Open360Reframe.log (the Fusion console is easy to miss)
local function logmsg(msg)
    local home = os.getenv("HOME") or "/tmp"
    local f = io.open(home .. "/Library/Logs/Open360Reframe.log", "a")
    if f then f:write(os.date("%Y-%m-%d %H:%M:%S  ") .. tostring(msg) .. "\n"); f:close() end
    print("Open360Reframe: " .. tostring(msg))
end

local function loadSidecar(path)
    if path == nil or path == "" then return nil end
    local c = sidecarCache[path]
    if c then return c end
    local f = io.open(path, "rb")
    if not f then return nil end
    local src = f:read("*a")
    f:close()
    local chunk = loadstring(src)
    if not chunk then return nil end
    setfenv(chunk, {})
    local ok, data = pcall(chunk)
    if not ok or type(data) ~= "table" then return nil end
    data._stabParsed = {}
    sidecarCache[path] = data
    return data
end

local stabNames = { [0] = "off", [1] = "smooth", [2] = "horizon", [3] = "lock" }

local function stabTable(sc, mode)
    local name = stabNames[mode] or "off"
    if sc._stabParsed[name] then return sc._stabParsed[name] end
    local s = sc.stab and sc.stab[name]
    local t = {}
    if type(s) == "string" then
        local i = 0
        for num in string.gmatch(s, "[^%s]+") do
            i = i + 1
            t[i] = tonumber(num)
        end
    end
    sc._stabParsed[name] = t
    return t
end

local function quatToMat(w, x, y, z)
    return {
        1 - 2*(y*y + z*z), 2*(x*y - w*z),     2*(x*z + w*y),
        2*(x*y + w*z),     1 - 2*(x*x + z*z), 2*(y*z - w*x),
        2*(x*z - w*y),     2*(y*z + w*x),     1 - 2*(x*x + y*y),
    }
end

local function matMul(a, b)
    local r = {}
    for i = 0, 2 do
        for j = 0, 2 do
            r[i*3 + j + 1] = a[i*3+1]*b[j+1] + a[i*3+2]*b[3+j+1] + a[i*3+3]*b[6+j+1]
        end
    end
    return r
end

local function rotX(a) local c, s = math.cos(a), math.sin(a); return {1,0,0, 0,c,-s, 0,s,c} end
local function rotY(a) local c, s = math.cos(a), math.sin(a); return {c,0,s, 0,1,0, -s,0,c} end
local function rotZ(a) local c, s = math.cos(a), math.sin(a); return {c,-s,0, s,c,0, 0,0,1} end

------------------------------------------------------------------------------

function Create()
    self:AddControlPage("Reframe")

    InProjection = self:AddInput("Output", "Projection", {
        LINKID_DataType = "Number", INPID_InputControl = "MultiButtonControl",
        INP_Default = 0, INP_Integer = true, INP_DoNotifyChanged = true,
        { MBTNC_AddButton = "Reframe", MBTNCD_ButtonWidth = 0.5 },
        { MBTNC_AddButton = "360 Equirect", MBTNCD_ButtonWidth = 0.5 },
    })

    InYaw = self:AddInput("Pan", "Yaw", {
        LINKID_DataType = "Number", INPID_InputControl = "ScrewControl",
        INP_Default = 0, INP_MinScale = -180, INP_MaxScale = 180,
    })
    InPitch = self:AddInput("Tilt", "Pitch", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0, INP_MinScale = -90, INP_MaxScale = 90, INP_MinAllowed = -90, INP_MaxAllowed = 90,
    })
    InRoll = self:AddInput("Roll", "Roll", {
        LINKID_DataType = "Number", INPID_InputControl = "ScrewControl",
        INP_Default = 0, INP_MinScale = -180, INP_MaxScale = 180,
    })
    InFOV = self:AddInput("Field of View", "FOV", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 100, INP_MinScale = 20, INP_MaxScale = 300, INP_MinAllowed = 1, INP_MaxAllowed = 340,
    })
    InCurve = self:AddInput("Lens Curve", "Curve", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 3,
    })
    InPreset = self:AddInput("Preset", "Preset", {
        LINKID_DataType = "Number", INPID_InputControl = "MultiButtonControl",
        INP_Default = 0, INP_Integer = true, INP_External = false, INP_DoNotifyChanged = true,
        INP_InitialNotify = false,
        { MBTNC_AddButton = "Natural", MBTNCD_ButtonWidth = 0.25 },
        { MBTNC_AddButton = "Wide", MBTNCD_ButtonWidth = 0.25 },
        { MBTNC_AddButton = "Fisheye", MBTNCD_ButtonWidth = 0.25 },
        { MBTNC_AddButton = "Tiny Planet", MBTNCD_ButtonWidth = 0.25 },
    })

    self:BeginControlNest("Output Size", "SizeNest", false)
    InUseComp = self:AddInput("Use Timeline Resolution", "UseCompSize", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl",
        INP_Integer = true, INP_Default = 1, INP_DoNotifyChanged = true,
    })
    InWidth = self:AddInput("Width", "Width", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Integer = true, INP_Default = 1920, INP_MinScale = 64, INP_MaxScale = 8192, INP_MinAllowed = 16,
    })
    InHeight = self:AddInput("Height", "Height", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Integer = true, INP_Default = 1080, INP_MinScale = 64, INP_MaxScale = 8192, INP_MinAllowed = 16,
    })
    self:EndControlNest()

    self:AddControlPage("360")

    InStab = self:AddInput("Stabilization", "Stabilize", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl",
        INP_Default = 2, INP_Integer = true,
        { CCS_AddString = "Off (raw camera)" },
        { CCS_AddString = "Smooth (keep camera moves)" },
        { CCS_AddString = "Horizon Lock (FlowState)" },
        { CCS_AddString = "Direction Lock" },
    })
    InHeading = self:AddInput("360 Heading Offset", "Heading", {
        LINKID_DataType = "Number", INPID_InputControl = "ScrewControl",
        INP_Default = 0, INP_MinScale = -180, INP_MaxScale = 180,
    })

    self:BeginControlNest("Stitching", "StitchNest", true)
    InAccessory = self:AddInput("Lens Accessory", "Accessory", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl",
        INP_Default = 0, INP_Integer = true,
        { CCS_AddString = "As analyzed" },
        { CCS_AddString = "Bare lenses" },
        { CCS_AddString = "Lens guards" },
        { CCS_AddString = "Water lens (X6, measured)" },
        { CCS_AddString = "Dive case, underwater (X5 profile)" },
        { CCS_AddString = "Dive case, in air (X5 profile)" },
    })
    InAutoStitch = self:AddInput("Use Analyzed Settings", "AutoStitch", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl",
        INP_Integer = true, INP_Default = 1, INP_DoNotifyChanged = true,
    })
    InDistance = self:AddInput("Stitch Distance (m, 0 = ∞)", "Distance", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 2, INP_MinScale = 0, INP_MaxScale = 10, INP_MinAllowed = 0,
    })
    InRadius = self:AddInput("Lens Radius Scale", "RadiusScale", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0.95, INP_MaxScale = 1.05, INP_MinAllowed = 0.5,
    })
    InFeather = self:AddInput("Seam Blend (°)", "Feather", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 3, INP_MinScale = 0.2, INP_MaxScale = 10, INP_MinAllowed = 0.05,
    })
    InGain = self:AddInput("Rear Lens Exposure", "Gain", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0.8, INP_MaxScale = 1.2, INP_MinAllowed = 0.1,
    })
    InShowSeam = self:AddInput("Highlight Seam", "ShowSeam", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl",
        INP_Integer = true, INP_Default = 0,
    })
    self:EndControlNest()

    self:BeginControlNest("Source", "SourceNest", false)
    InSidecar = self:AddInput("Sidecar", "Sidecar", {
        LINKID_DataType = "Text", INPID_InputControl = "FileControl",
        FC_IsSaver = false, FC_ClipBrowse = false, INP_DoNotifyChanged = true,
        FCS_FilterString = "open360 sidecar (*.open360.lua)|*.lua",
    })
    InFrameOffset = self:AddInput("Source Frame Offset", "FrameOffset", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Integer = true, INP_Default = 0, INP_MinScale = -1000, INP_MaxScale = 1000,
    })
    InFpsRatio = self:AddInput("Source/Comp FPS Ratio", "FpsRatio", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0.25, INP_MaxScale = 4, INP_MinAllowed = 0.01,
    })
    self:EndControlNest()

    InLens0 = self:AddInput("Lens 0", "Lens0", {
        LINKID_DataType = "Image", LINK_Main = 1,
    })
    InLens1 = self:AddInput("Lens 1", "Lens1", {
        LINKID_DataType = "Image", LINK_Main = 2, INP_Required = false,
    })
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image", LINK_Main = 1,
    })
end

function NotifyChanged(inp, param, time)
    if inp == InPreset and param then
        local p = param.Value
        local presets = {
            [0] = { fov = 100, curve = 0, pitch = nil },
            [1] = { fov = 130, curve = 0.35, pitch = nil },
            [2] = { fov = 180, curve = 1.0, pitch = nil },
            [3] = { fov = 260, curve = 1.0, pitch = -90 },
        }
        local s = presets[p]
        if s then
            InFOV:SetSource(Number(s.fov), time)
            InCurve:SetSource(Number(s.curve), time)
            if s.pitch then InPitch:SetSource(Number(s.pitch), time) end
        end
    elseif inp == InUseComp and param then
        local custom = param.Value < 0.5
        InWidth:SetAttrs({ IC_Visible = custom })
        InHeight:SetAttrs({ IC_Visible = custom })
    elseif inp == InAutoStitch and param then
        local manual = param.Value < 0.5
        InDistance:SetAttrs({ IC_Visible = manual })
        InGain:SetAttrs({ IC_Visible = manual })
        InRadius:SetAttrs({ IC_Visible = manual })
    elseif inp == InProjection and param then
        local re = param.Value < 0.5
        InFOV:SetAttrs({ IC_Visible = re })
        InCurve:SetAttrs({ IC_Visible = re })
        InPreset:SetAttrs({ IC_Visible = re })
    end
end

local function packLens(L, layoutOffset, layoutScale, radial)
    local p = {}
    for i = 0, 33 do p[i] = 0 end
    p[0] = L.xi; p[1] = L.fx; p[2] = L.fy; p[3] = L.cx; p[4] = L.cy
    p[5] = L.k[1]; p[6] = L.k[2]; p[7] = L.k[3]; p[8] = L.k[4]
    if L.p then p[9] = L.p[1]; p[10] = L.p[2] end
    if L.s then p[11] = L.s[1]; p[12] = L.s[2]; p[13] = L.s[3]; p[14] = L.s[4] end
    p[15] = L.t[1]; p[16] = L.t[2]; p[17] = L.t[3]
    p[18] = L.radius or 0.4925
    p[19] = layoutOffset; p[20] = layoutScale
    p[21] = radial[1]; p[22] = radial[2]; p[23] = radial[3]
    for i = 1, 9 do p[23 + i] = L.R[i] end
    return p
end

-- Insta360 lens-accessory profiles: theta (deg) -> image height (mm) polynomials
-- (X5 trailer field 145; the X6 stores none, so these are the closest available).
local accessoryProfiles = {
    bare = { 0, 0.03159, -8.415e-05, 2.201e-06, -1.284e-08 },
    ["guard"] = { 0, 0.0321906505, -9.37245e-05, 2.5248e-06, -1.5e-08 },
    ["dive-water"] = { 0.000238, 0.03112, 7.306e-06, 4.427e-07, -3.892e-09 },
    ["dive-air"] = { 0, 0.0299338566, 4.86874e-05, -6.784e-07, 1.2e-09 },
}
local accessoryNames = { [1] = "bare", [2] = "guard", [3] = "water", [4] = "dive-water", [5] = "dive-air" }
-- parametric per-lens radius profiles {r0, a1, a2}; "water" = Insta360 X6 water lens,
-- fitted against Insta360 Studio renders (README: "Lens accessories")
local radialPresets = {
    water = { { 1.0778, -0.0311, -0.0416 }, { 1.0646, -0.0318, 0.0 } },
}

function ProcessImpl(req)
    local img0 = InLens0:GetValue(req)
    local img1 = InLens1:GetValue(req)
    local projection = InProjection:GetValue(req).Value
    local deg = math.pi / 180

    -- output size
    local W, H
    if InUseComp:GetValue(req).Value > 0.5 then
        local prefs = self.Comp:GetPrefs("Comp.FrameFormat")
        W = (prefs and prefs.Width) or 1920
        H = (prefs and prefs.Height) or 1080
    else
        W = InWidth:GetValue(req).Value
        H = InHeight:GetValue(req).Value
    end
    if projection == 1 and InUseComp:GetValue(req).Value > 0.5 then
        -- full-quality 360 master: 2 x lens resolution, 2:1
        local lw = img0.Width
        W = math.max(W, math.floor(lw * 2 / 4) * 4)
        H = W / 2
    end
    W = math.floor(W); H = math.floor(H)

    local out = Image({
        IMG_Like = img0,
        IMG_Width = W, IMG_Height = H,
        IMG_XScale = 1.0, IMG_YScale = 1.0,
        IMAT_OriginalWidth = W, IMAT_OriginalHeight = H,
        IMG_NoData = req:IsPreCalc(),
    })
    if req:IsPreCalc() then
        OutImage:Set(req, out)
        return
    end

    local sc = loadSidecar(InSidecar:GetValue(req).Value)
    local equirectIn = (sc == nil) and 1 or 0
    if sc == nil and img1 ~= nil then equirectIn = 0 end

    -- stabilization rotation for the current source frame
    local stab = {1,0,0, 0,1,0, 0,0,1}
    if sc then
        local mode = InStab:GetValue(req).Value
        local t = stabTable(sc, mode)
        local n = #t / 4
        if n > 0 then
            local f = math.floor((req.Time + InFrameOffset:GetValue(req).Value) * InFpsRatio:GetValue(req).Value + 0.5)
            f = math.max(0, math.min(n - 1, f))
            stab = quatToMat(t[f*4+1], t[f*4+2], t[f*4+3], t[f*4+4])
        end
    end
    -- heading offset rotates the whole sphere (before the view camera)
    local heading = rotY(InHeading:GetValue(req).Value * deg)
    stab = matMul(stab, heading)

    local yaw = InYaw:GetValue(req).Value * deg
    local pitch = InPitch:GetValue(req).Value * deg
    local roll = InRoll:GetValue(req).Value * deg
    local cam = matMul(rotY(yaw), matMul(rotX(-pitch), rotZ(roll)))

    local fov = InFOV:GetValue(req).Value * deg
    local curve = InCurve:GetValue(req).Value
    -- plane half-width so that the horizontal edge lands exactly at fov/2 from the axis
    local th = math.min(fov * 0.5, math.pi * 0.999)
    local tanHalf
    if curve < 1e-4 then
        th = math.min(th, 89.5 * deg)
        tanHalf = math.tan(th)
    else
        local denom = curve + math.cos(th)
        if denom < 1e-3 then denom = 1e-3 end
        tanHalf = (1 + curve) * math.sin(th) / denom
    end

    local node = DVIPComputeNode(req, "ReframeKernel", ReframeKernel, "ReframeParams", ReframeParams)
    if not node then
        logmsg("DVIPComputeNode could not be created (kernel compile error?)")
        OutImage:Set(req, nil)
        return
    end
    local params = node:GetParamBlock(ReframeParams)

    if sc and sc.lenses and sc.lenses[1] and sc.lenses[2] then
        local layout = sc.layout or "tracks"
        local o0, s0, o1, s1 = 0, 1, 0, 1
        if layout == "sbs" then o0, s0, o1, s1 = 0, 0.5, 0.5, 0.5
        elseif layout == "sbs_swapped" then o0, s0, o1, s1 = 0.5, 0.5, 0, 0.5 end
        local auto = InAutoStitch:GetValue(req).Value > 0.5
        -- accessory: 0 = as analyzed, otherwise explicit
        local accSel = InAccessory:GetValue(req).Value
        local accName = accessoryNames[accSel] or ((sc.stitch and sc.stitch.accessory) or "bare")
        local function radialFor(i)
            local L = sc.lenses[i]
            local r
            if accSel == 0 and L.radial then
                r = { L.radial[1], L.radial[2], L.radial[3] }
            else
                local pr = radialPresets[accName]
                r = pr and { pr[i][1], pr[i][2], pr[i][3] } or { 1, 0, 0 }
            end
            if not auto then r[1] = r[1] * InRadius:GetValue(req).Value end
            return r
        end
        local p0 = packLens(sc.lenses[1], o0, s0, radialFor(1))
        local p1 = packLens(sc.lenses[2], o1, s1, radialFor(2))
        for i = 0, 33 do params.lens0[i] = p0[i]; params.lens1[i] = p1[i] end
        local prof = accessoryProfiles[accName]
        for i = 0, 10 do params.acc[i] = 0 end
        if prof and accName ~= "bare" then
            for i = 0, 4 do params.acc[i] = accessoryProfiles.bare[i + 1]; params.acc[5 + i] = prof[i + 1] end
            params.acc[10] = 1
        end
    end
    for i = 0, 8 do params.stab[i] = stab[i + 1]; params.cam[i] = cam[i + 1] end
    params.dstsize[0] = W
    params.dstsize[1] = H
    params.projection = projection
    params.equirectIn = equirectIn
    params.showSeam = InShowSeam:GetValue(req).Value
    params.tanHalf = tanHalf
    params.curve = curve
    params.aspect = W / H
    params.feather = math.max(0.05, InFeather:GetValue(req).Value) * deg

    local dist, gain = InDistance:GetValue(req).Value, InGain:GetValue(req).Value
    if sc and sc.stitch and InAutoStitch:GetValue(req).Value > 0.5 then
        dist = sc.stitch.distance or 0
        gain = sc.stitch.gain or 1
    end
    params.invDist = (dist and dist > 0.01) and (1 / dist) or 0
    params.gain1 = gain

    node:SetParamBlock(params)
    node:AddSampler("RowSampler", TEX_FILTER_MODE_LINEAR, TEX_ADDRESS_MODE_CLAMP, TEX_NORMALIZED_COORDS_TRUE)
    node:AddInput("src0", img0)
    node:AddInput("src1", img1 or img0)
    node:AddOutput("dst", out)
    local ok = node:RunSession(req)
    if not ok then
        logmsg("GPU kernel RunSession failed (see Fusion console for compiler output)")
        out = nil
    end
    OutImage:Set(req, out)
end

function Process(req)
    local ok, err = pcall(ProcessImpl, req)
    if not ok then
        logmsg("Process error: " .. tostring(err))
        error(err)
    end
end
